{
  "lexicon": 1,
  "id": "net.nusno.gyoka.feed.defs",
  "defs": {
    "feedView": {
      "type": "object",
      "description": "A Gyoka feed entry.",
      "required": ["uri", "orderRevision", "langFilter", "isActive"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the feed generator record."
        },
        "orderRevision": {
          "type": "integer",
          "minimum": 0,
          "description": "Current feed order revision."
        },
        "langFilter": {
          "type": "boolean",
          "description": "Whether language filtering is enabled for the feed."
        },
        "isActive": {
          "type": "boolean",
          "description": "Whether the feed is currently active."
        }
      }
    },
    "postInput": {
      "type": "object",
      "required": ["uri", "cid"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the app.bsky.feed.post record to add."
        },
        "cid": {
          "type": "string",
          "format": "cid",
          "description": "CID of the post record."
        },
        "languages": {
          "type": "array",
          "maxLength": 5,
          "description": "Optional language tags for the post. The wildcard '*' is accepted, and non-wildcard values are normalized to primary language subtags.",
          "items": {
            "type": "string",
            "description": "A BCP-47 language tag or the wildcard '*'."
          }
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime",
          "description": "Timestamp recorded when the post is added. Defaults to the current time when omitted."
        },
        "reason": {
          "type": "union",
          "refs": ["#skeletonReasonRepost", "#skeletonReasonPin"],
          "closed": true,
          "description": "Reason for including the post in the feed skeleton."
        }
      }
    },
    "postView": {
      "type": "object",
      "required": ["uri", "cid", "languages", "indexedAt"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "cid": {
          "type": "string",
          "format": "cid"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Normalized primary language tag or '*'."
          }
        },
        "indexedAt": {
          "type": "string",
          "format": "datetime"
        },
        "reason": {
          "type": "union",
          "refs": ["#skeletonReasonRepost", "#skeletonReasonPin"],
          "closed": true
        }
      }
    },
    "placement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["append", "prepend", "before", "after"]
        },
        "anchor": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the anchor post. Required by before and after placements."
        }
      }
    },
    "postResult": {
      "type": "object",
      "required": ["uri", "action"],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri"
        },
        "action": {
          "type": "string",
          "enum": ["created", "updated", "unchanged", "failed", "removed", "notFound"]
        },
        "error": {
          "type": "string",
          "description": "Error code for a failed item."
        }
      }
    },
    "skeletonReasonRepost": {
      "type": "object",
      "required": ["repost"],
      "properties": {
        "repost": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the app.bsky.feed.repost record associated with this reason."
        }
      }
    },
    "skeletonReasonPin": {
      "type": "object",
      "properties": {}
    }
  }
}
